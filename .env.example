# Copy to .env.local and adjust for your environment
# Use localhost if mongod is running locally, or your remote host (e.g. MongoDB Atlas / VPS)
MONGODB_URI=mongodb://127.0.0.1:27017/onehabitat

# Admin authentication (required for /admin)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Seed the first super admin on first admin API request (optional)
ADMIN_SEED_EMAIL=admin@onehabitat.com
ADMIN_SEED_PASSWORD=ChangeMeNow123!
ADMIN_SEED_NAME=Super Admin
