# Copy to .env.local for local development.
# For deployment (Vercel, VPS, etc.), set the same variables in your host's environment settings.
# .env.local is NOT deployed with the app.

# Remote MongoDB (production / shared DB example)
MONGODB_URI=mongodb://USER:PASSWORD@YOUR_HOST:27017/onehabitat?authSource=onehabitat

# Optional: override database name if it is not in the URI path
# MONGODB_DB_NAME=onehabitat

# MongoDB connection timeouts (milliseconds)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGODB_CONNECT_TIMEOUT_MS=30000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# Admin authentication (required for /admin)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Seed the first super admin on first admin API request (optional)
ADMIN_SEED_EMAIL=admin@onehabitat.com
ADMIN_SEED_PASSWORD=ChangeMeNow123!
ADMIN_SEED_NAME=Super Admin

# OpenAI vision analysis (required for live AI diagnostics)
OPENAI_API_KEY=your_openai_api_key_here
# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Public site URL used in booking notification emails (image links)
# APP_URL=https://onehabitat.in

# Booking notification email (SMTP)
BOOKING_NOTIFICATION_EMAIL=srinivasreddy.sr78@gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=hello@onehabitat.in

# After deployment, verify DB connectivity:
# GET https://your-domain.com/api/health/db